RECONCILEHUB_ENV=development
RECONCILEHUB_HOST=0.0.0.0
RECONCILEHUB_PORT=8000
RECONCILEHUB_DB_PATH=runtime/reconcile_hub.db
RECONCILEHUB_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
RECONCILEHUB_ALLOWED_ORIGINS=
RECONCILEHUB_LOG_LEVEL=INFO
RECONCILEHUB_LOG_DIR=logs
RECONCILEHUB_BACKUP_ENABLED=false
RECONCILEHUB_BACKUP_DIR=backups
RECONCILEHUB_BACKUP_INTERVAL_HOURS=24
RECONCILEHUB_BACKUP_RETENTION_DAYS=14
RECONCILEHUB_AI_MODEL=gpt-6-astra

# Vorona PostgreSQL (keep real credentials only in local .env)
VORONA_DB_HOST=localhost
VORONA_DB_PORT=5432
VORONA_DB_NAME=VORONA
VORONA_DB_USER=postgres
VORONA_DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
# Optional complete SQLAlchemy URL. When set, it overrides the fields above.
# VORONA_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/VORONA
